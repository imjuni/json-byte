---
import '#/index.css';

interface Props {
  canonicalPath?: string;
  description: string;
  title: string;
}

const { canonicalPath = '/', description, title } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/json-byte-desktop-screenshot-001.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="RovinjSoft" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JSON Byte" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1468" />
    <meta property="og:image:height" content="859" />
    <meta property="og:image:alt" content="JSON Byte JSON and YAML visualization interface" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rovinjsoft" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="JSON Byte JSON and YAML visualization interface" />
    <link rel="icon" type="image/png" href="/json-byte-favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="JSON Byte information for language models" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "JSON Byte",
        "url": "https://json-byte.pages.dev",
        "image": "https://json-byte.pages.dev/json-byte-mobile-screenshot-001.png",
        "author": {
          "@type": "Organization",
          "name": "RovinjSoft",
          "url": "https://rovinjsoft.com"
        },
        "publisher": {
          "@type": "Organization",
          "name": "RovinjSoft",
          "url": "https://rovinjsoft.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://rovinjsoft.com/icon_body.png"
          }
        },
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "description": "Visualize and explore JSON or YAML data as an interactive graph in your browser.",
        "softwareVersion": "3.1.0",
        "isAccessibleForFree": true,
        "browserRequirements": "Requires JavaScript and a modern web browser",
        "featureList": [
          "JSON and YAML graph visualization",
          "Interactive node search and navigation",
          "JSONPath and jq path lookup",
          "JSON and YAML document comparison",
          "Local-only browser processing"
        ],
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "license": "https://www.apache.org/licenses/LICENSE-2.0"
      }
    </script>
  </head>
  <body>
    <h1 class="sr-only">{title}</h1>
    <slot />
  </body>
</html>
