---
import '#/index.css';

interface Props {
  canonicalPath?: string;
  description: string;
  featureList: string[];
  keywords: string[];
  seoHeading: string;
  title: string;
}

const { canonicalPath = '/', description, featureList, keywords, seoHeading, title } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/json-byte-desktop-screenshot-001.png', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'JSON Byte',
  url: canonicalUrl,
  image: socialImage,
  author: {
    '@type': 'Organization',
    name: 'RovinjSoft',
    url: 'https://rovinjsoft.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'RovinjSoft',
    url: 'https://rovinjsoft.com',
  },
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'JSON and YAML developer tool',
  operatingSystem: 'Web',
  description,
  softwareVersion: '3.1.0',
  isAccessibleForFree: true,
  browserRequirements: 'Requires JavaScript and a modern web browser',
  featureList,
  keywords: keywords.join(', '),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="RovinjSoft" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JSON Byte" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1468" />
    <meta property="og:image:height" content="859" />
    <meta property="og:image:alt" content="JSON Byte JSON and YAML visualization interface" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rovinjsoft" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="JSON Byte JSON and YAML visualization interface" />
    <link rel="icon" type="image/png" href="/json-byte-favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="JSON Byte information for language models" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <section class="sr-only" aria-label="About this tool">
      <h1>{seoHeading}</h1>
      <p>{description}</p>
      <ul>
        {featureList.map((feature) => <li>{feature}</li>)}
      </ul>
    </section>
    <slot />
  </body>
</html>
