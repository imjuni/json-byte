---
import '#/index.css';

interface Props {
  canonicalPath?: string;
  description: string;
  title: string;
}

const { canonicalPath = '/', description, title } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="RovinjSoft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://json-byte.pages.dev/json-byte-desktop-screenshot-001.png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rovinjsoft" />
    <link rel="icon" type="image/png" href="/json-byte-favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "JSON Byte",
        "url": "https://json-byte.pages.dev",
        "image": "https://json-byte.pages.dev/json-byte-mobile-screenshot-001.png",
        "author": {
          "@type": "Organization",
          "name": "RovinjSoft",
          "url": "https://rovinjsoft.com"
        },
        "publisher": {
          "@type": "Organization",
          "name": "RovinjSoft",
          "url": "https://rovinjsoft.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://rovinjsoft.com/icon_body.png"
          }
        },
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "description": "Visualize and explore JSON or YAML data as an interactive graph in your browser.",
        "softwareVersion": "2.0.0",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "license": "https://www.apache.org/licenses/LICENSE-2.0"
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
